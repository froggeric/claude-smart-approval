{
  "description": "AI permission tier for Bash commands: deny-list gate plus smart evaluation",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/auto-approve.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
